{
  "appId": "com.kokanastha.store",
  "productName": "Kokanastha Store",
  "asar": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron-main.cjs",
    "package.json",
    ".env"
  ],
  "mac": {
    "category": "public.app-category.business"
  },
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kokanastha Store"
  },
  "linux": {
    "target": "AppImage"
  }
}
